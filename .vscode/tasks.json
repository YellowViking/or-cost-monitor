{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "compile",
      "path": "${workspaceFolder}/or-cost-monitor",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "type": "npm",
      "script": "watch",
      "path": "${workspaceFolder}/or-cost-monitor",
      "isBackground": true,
      "problemMatcher": {
        "owner": "esbuild",
        "pattern": {
          "regexp": "error"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "watching for changes",
          "endsPattern": ".*"
        }
      },
      "presentation": {
        "reveal": "never",
        "panel": "dedicated"
      }
    }
  ]
}